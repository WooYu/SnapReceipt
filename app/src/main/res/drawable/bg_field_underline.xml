<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 只保留底部 1dp 分割线 -->
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#E8ECF4" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
