<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle"> <!-- 渐变形状：矩形（可改为oval/line/ring） -->
    <!-- 渐变角度：0=从左到右，90=从下到上，180=从右到左，270=从上到下 -->
    <gradient
        android:angle="270"
        android:endColor="#00103CED"
        android:startColor="@color/colorPrimary"
        android:type="linear" />
</shape>