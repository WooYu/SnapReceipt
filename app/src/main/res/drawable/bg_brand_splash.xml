<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F8FAFC"
                android:startColor="#ECF0FA" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.16"
                android:centerY="0.24"
                android:endColor="#00C8D6F0"
                android:gradientRadius="420dp"
                android:startColor="#BFD5F4"
                android:type="radial" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.34"
                android:endColor="#00E7F8FF"
                android:gradientRadius="520dp"
                android:startColor="#9BEAF8FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
