<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.snapreceipt.io.ui.widget.statefullist.MultiStateLayout
        android:id="@+id/sll_multi_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--加载态-->
        <LinearLayout
            android:id="@+id/sll_loading_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.skybound.space.base.presentation.widget.BrandLoadingView
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/sll_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/loading_please_wait_dynamic"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_secondary" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/sll_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/sll_content_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sll_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!--空状态-->
        <LinearLayout
            android:id="@+id/sll_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/sll_empty_image"
                android:layout_width="240dp"
                android:layout_height="140dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/no_content"
                android:src="@drawable/img_receipts_empty" />

            <TextView
                android:id="@+id/sll_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/no_content"
                android:textColor="@color/text_muted_dark"
                android:textSize="@dimen/text_size_secondary" />
        </LinearLayout>

        <!--错误状态-->
        <LinearLayout
            android:id="@+id/sll_error_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/sll_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/unexpected_error"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_secondary"
                tools:text="Unexpected error" />

            <com.snapreceipt.io.ui.widget.PrimaryActionButton
                android:id="@+id/sll_error_retry"
                android:layout_width="120dp"
                android:layout_height="@dimen/button_height_small"
                android:layout_marginTop="16dp"
                android:text="@string/retry"
                app:pabEnableShadow="false" />
        </LinearLayout>
    </com.snapreceipt.io.ui.widget.statefullist.MultiStateLayout>
</merge>
