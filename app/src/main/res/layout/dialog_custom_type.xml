<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_card_large"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="16dp">

    <!--标题-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/select_invoice_type"
            android:src="@drawable/ic_bookmark_light" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/custom_type_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <EditText
        android:id="@+id/custom_type_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_custom_type_input"
        android:gravity="center"
        android:hint="@string/custom_type_hint"
        android:inputType="textCapWords|textMultiLine"
        android:maxLength="30"
        android:minHeight="40dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="13dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="@dimen/text_size_secondary" />

    <LinearLayout
        android:id="@+id/loading_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/category_operation_adding"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_small" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <!--取消-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginEnd="27dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            app:pabBackgroundStyle="solid"
            app:pabEnableShadow="false"
            app:pabPressedDarkenFactor="0.92"
            app:pabSolidColor="@android:color/white"
            app:pabStrokeColor="@color/text_secondary"
            app:pabStrokeWidth="1dp"
            app:pabTextColor="@color/text_primary" />

        <!--确认-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/confirm_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="@string/confirm"
            app:pabEnableShadow="false" />
    </LinearLayout>

</LinearLayout>
