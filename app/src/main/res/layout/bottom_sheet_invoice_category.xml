<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_surface_bottom_sheet_filter"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/select_invoice_category"
            android:src="@drawable/ic_bookmark_light" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/select_invoice_category"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recommend section header -->
            <TextView
                android:id="@+id/recommend_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/category_section_recommend"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small" />

            <!-- Recommend items container -->
            <LinearLayout
                android:id="@+id/recommend_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_recommend_container"
                android:orientation="vertical"
                android:paddingVertical="4dp" />

            <!-- Customize section header -->
            <TextView
                android:id="@+id/customize_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/category_section_customize"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small"
                android:visibility="gone" />

            <!-- Custom items container -->
            <LinearLayout
                android:id="@+id/custom_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Add category button -->
            <TextView
                android:id="@+id/add_category_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_dashed"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/category_add"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_size_secondary"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal">

        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginEnd="27dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            app:pabBackgroundStyle="solid"
            app:pabEnableShadow="false"
            app:pabPressedDarkenFactor="0.92"
            app:pabSolidColor="@android:color/white"
            app:pabStrokeColor="@color/text_secondary"
            app:pabStrokeWidth="1dp"
            app:pabTextColor="@color/text_primary" />

        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/confirm_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="@string/confirm"
            app:pabEnableShadow="false" />
    </LinearLayout>

</LinearLayout>
