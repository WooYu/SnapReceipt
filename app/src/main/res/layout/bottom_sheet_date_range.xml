<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp">

    <!--标题-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/select_date_title"
            android:src="@drawable/ic_calendar_light" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/select_date_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <!--选择的日期范围-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/start_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_date_chip_selected"
            android:gravity="center"
            android:minHeight="40dp"
            android:padding="9dp"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold"
            tools:text="2024/12/10" />

        <View
            android:layout_width="19dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="10dp"
            android:background="#D6DCE8"
            android:gravity="center" />

        <TextView
            android:id="@+id/end_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_date_chip_default"
            android:gravity="center"
            android:minHeight="40dp"
            android:padding="9dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold"
            tools:text="2024/12/10" />
    </LinearLayout>

    <!--年月日-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/year_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/month_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/day_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_small"
            android:textStyle="bold" />
    </LinearLayout>

    <!--滚轮-->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="16dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="@color/picker_selection_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <NumberPicker
                android:id="@+id/picker_year"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:descendantFocusability="blocksDescendants" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/picker_column_divider" />

            <NumberPicker
                android:id="@+id/picker_month"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:descendantFocusability="blocksDescendants" />

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/picker_column_divider" />

            <NumberPicker
                android:id="@+id/picker_day"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:descendantFocusability="blocksDescendants" />
        </LinearLayout>
    </FrameLayout>

    <!--按钮-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <!--取消-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginEnd="27dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            app:pabBackgroundStyle="solid"
            app:pabEnableShadow="false"
            app:pabPressedDarkenFactor="0.92"
            app:pabSolidColor="@android:color/white"
            app:pabStrokeColor="@color/text_secondary"
            app:pabStrokeWidth="1dp"
            app:pabTextColor="@color/text_primary" />

        <!--确认-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/confirm_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="@string/confirm"
            app:pabEnableShadow="false" />
    </LinearLayout>

</LinearLayout>
