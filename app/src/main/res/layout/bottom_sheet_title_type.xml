<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_bottom_sheet_filter"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp">

    <!--标题-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/select_invoice_type"
            android:src="@drawable/ic_bookmark_light" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/select_invoice_type"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <!--选项列表-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="vertical">

        <!-- Individual 选项 -->
        <LinearLayout
            android:id="@+id/option_individual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_card_small"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:id="@+id/title_individual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/type_individual"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_secondary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/check_individual"
                android:layout_width="@dimen/check_box_size"
                android:layout_height="@dimen/check_box_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle_filled"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Business 选项 -->
        <LinearLayout
            android:id="@+id/option_business"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_surface_card_small"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">

            <TextView
                android:id="@+id/title_company"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/type_company"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_secondary"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/check_business"
                android:layout_width="@dimen/check_box_size"
                android:layout_height="@dimen/check_box_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle_filled"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginEnd="27dp"
            android:layout_weight="1"
            android:text="@string/reset"
            app:pabBackgroundStyle="solid"
            app:pabEnableShadow="false"
            app:pabPressedDarkenFactor="0.92"
            app:pabSolidColor="@android:color/white"
            app:pabStrokeColor="@color/text_secondary"
            app:pabStrokeWidth="1dp"
            app:pabTextColor="@color/text_primary" />

        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/confirm_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="@string/confirm"
            app:pabEnableShadow="false" />
    </LinearLayout>

</LinearLayout>
