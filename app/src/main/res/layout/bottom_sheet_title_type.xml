<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_surface_bottom_sheet"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="16dp">

    <!--标题-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/select_invoice_type"
            android:src="@drawable/ic_bookmark_light" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/select_invoice_type"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <!--选择发票类型-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title_individual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:background="@drawable/bg_chip_selector"
            android:gravity="center"
            android:minWidth="90dp"
            android:minHeight="40dp"
            android:paddingHorizontal="11dp"
            android:paddingVertical="13dp"
            android:text="@string/type_individual"
            android:textColor="@color/chip_text_selector"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_selector"
            android:gravity="center"
            android:minWidth="90dp"
            android:minHeight="40dp"
            android:paddingHorizontal="11dp"
            android:paddingVertical="13dp"
            android:text="@string/type_company"
            android:textColor="@color/chip_text_selector"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal">

        <!--取消-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginEnd="27dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            app:pabBackgroundStyle="solid"
            app:pabEnableShadow="false"
            app:pabPressedDarkenFactor="0.92"
            app:pabSolidColor="@android:color/white"
            app:pabStrokeColor="@color/text_secondary"
            app:pabStrokeWidth="1dp"
            app:pabTextColor="@color/text_primary" />

        <!--确认-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/confirm_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_small"
            android:layout_weight="1"
            android:text="@string/confirm"
            app:pabEnableShadow="false" />
    </LinearLayout>

</LinearLayout>
