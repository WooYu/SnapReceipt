<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/page_start_margin" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/page_end_margin" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/status_bar_height" />

    <com.snapreceipt.io.ui.widget.PageTitleBar
        android:id="@+id/page_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:ptbTitleText="@string/about_us" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/page_start_margin"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="@dimen/page_end_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/page_header">

        <!--图标-->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_app_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_version_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_secondary" />

        <!--用户协议-->
        <com.snapreceipt.io.ui.widget.MeMenuItemView
            android:id="@+id/menu_user_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:mmivIcon="@drawable/ic_me_about"
            app:mmivTitle="@string/user_agreement" />

        <!--隐私协议-->
        <com.snapreceipt.io.ui.widget.MeMenuItemView
            android:id="@+id/menu_privacy_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:mmivIcon="@drawable/ic_me_about"
            app:mmivTitle="@string/privacy_policy_label" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
