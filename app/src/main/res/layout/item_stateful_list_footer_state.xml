<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:visibility="visible">

    <LinearLayout
        android:id="@+id/sll_footer_loading_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <com.skybound.space.base.presentation.widget.BrandLoadingView
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:blvShowTrack="false" />

        <TextView
            android:id="@+id/sll_footer_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/loading_more_records"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sll_footer_no_more_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="52dp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:text="@string/no_more_records"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
