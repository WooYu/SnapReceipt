<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--左边界-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/page_start_margin" />

    <!--右边界-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/page_end_margin" />

    <!--上边界-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/status_bar_height" />

    <!--背景-->
    <View
        android:id="@+id/header_glow"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_me_header_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.snapreceipt.io.ui.widget.SnapCardView
        android:id="@+id/edit_profile_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@id/bound_right"
        app:layout_constraintStart_toStartOf="@id/bound_left"
        app:layout_constraintTop_toTopOf="@id/bound_top"
        app:scvShowShadow="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="20dp">

            <!--头像-->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/img_app_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/SnapReceiptCircleAvatarShape" />

            <!--姓名-->
            <TextView
                android:id="@+id/username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/email"
                app:layout_constraintEnd_toStartOf="@id/iv_avatar_arrow"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="@string/placeholder_dash" />

            <!--邮箱-->
            <TextView
                android:id="@+id/email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_secondary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_avatar_arrow"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintTop_toBottomOf="@id/username"
                tools:text="@string/placeholder_dash" />

            <ImageView
                android:id="@+id/iv_avatar_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/edit_profile"
                android:src="@drawable/ic_chevron_right_large"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.snapreceipt.io.ui.widget.SnapCardView>

    <LinearLayout
        android:id="@+id/menu_export"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_surface_card_small"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="@id/bound_right"
        app:layout_constraintStart_toStartOf="@id/bound_left"
        app:layout_constraintTop_toBottomOf="@id/edit_profile_btn">

        <ImageView
            android:id="@+id/menu_export_icon"
            android:layout_width="@dimen/icon_size_small"
            android:layout_height="@dimen/icon_size_small"
            android:contentDescription="@null"
            android:src="@drawable/ic_me_export" />

        <TextView
            android:id="@+id/menu_export_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:text="@string/export_records"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/menu_export_arrow"
            android:layout_width="@dimen/arrow_size_small"
            android:layout_height="@dimen/arrow_size_small"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right_small" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_surface_card_large"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/bound_right"
        app:layout_constraintStart_toStartOf="@id/bound_left"
        app:layout_constraintTop_toBottomOf="@id/menu_export">

        <!--我的-->
        <com.snapreceipt.io.ui.widget.MeMenuItemView
            android:id="@+id/menu_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:mmivIcon="@drawable/ic_me_about"
            app:mmivTitle="@string/about_us" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="46dp"
            android:layout_marginEnd="16dp"
            android:background="@color/line_mine" />

        <!--意见反馈-->
        <com.snapreceipt.io.ui.widget.MeMenuItemView
            android:id="@+id/menu_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:mmivIcon="@drawable/ic_me_feedback"
            app:mmivTitle="@string/feedback" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="46dp"
            android:layout_marginEnd="16dp"
            android:background="@color/line_mine" />

        <!--设置-->
        <com.snapreceipt.io.ui.widget.MeMenuItemView
            android:id="@+id/menu_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:mmivIcon="@drawable/ic_me_settings"
            app:mmivTitle="@string/settings" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
