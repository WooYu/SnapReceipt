<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!--上边界-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bound_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="@dimen/status_bar_height" />

    <!--顶部背景，代码中设置弧形-->
    <View
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_header_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--标题-->
    <TextView
        android:id="@+id/toolbar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:gravity="center"
        android:text="@string/receipts_title"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_size_title"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/header_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 筛选栏 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/filter_bar"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_bg">

        <!--日期-->
        <TextView
            android:id="@+id/filter_date_btn"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingStart="@dimen/page_start_margin"
            android:text="@string/filter_date"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--分类-->
        <TextView
            android:id="@+id/filter_title_btn"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/filter_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--类型-->
        <TextView
            android:id="@+id/filter_type_btn"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:drawableEnd="@drawable/ic_chevron_down"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingEnd="@dimen/page_end_margin"
            android:text="@string/filter_type"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_secondary"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/page_start_margin"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/page_end_margin"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@id/action_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_bar">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 空状态：与首页一致 -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="240dp"
                    android:layout_height="140dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/no_content"
                    android:src="@drawable/img_receipts_empty" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/no_content"
                    android:textColor="@color/text_muted_dark"
                    android:textSize="@dimen/text_size_secondary" />
            </LinearLayout>

            <!--列表-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/receipt_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="36dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/item_receipt_select"
                tools:orientation="vertical"
                tools:showLayoutMargins="true" />

            <ProgressBar
                android:id="@+id/load_more_indicator"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!--没有更多-->
            <TextView
                android:id="@+id/no_more_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:text="@string/no_more_records"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 选择模式底部操作栏 -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_export_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_start_margin"
        android:paddingEnd="@dimen/page_end_margin"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <!--选中所有-->
        <LinearLayout
            android:id="@+id/select_all_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/select_all_icon"
                android:layout_width="@dimen/check_box_size"
                android:layout_height="@dimen/check_box_size"
                android:contentDescription="@string/select_all"
                android:src="@drawable/ic_select_toggle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/select_all"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />
        </LinearLayout>

        <!--金额-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_label"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_small" />

            <TextView
                android:id="@+id/total_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="$0.00"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--导出-->
        <com.snapreceipt.io.ui.widget.PrimaryActionButton
            android:id="@+id/export_action_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:minWidth="120dp"
            android:padding="12dp"
            android:text="@string/export"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_size_primary" />

    </LinearLayout>

    <!--导出加载框-->
    <FrameLayout
        android:id="@+id/export_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_loading_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ProgressBar
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/exporting_receipts"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
