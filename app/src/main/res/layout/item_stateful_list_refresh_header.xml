<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/sll_refresh_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/sll_refresh_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/pull_to_refresh"
            android:rotation="0"
            android:src="@drawable/ic_chevron_down_solid"
            android:tint="@color/text_secondary" />

        <com.skybound.space.base.presentation.widget.BrandLoadingView
            android:id="@+id/sll_refresh_loading"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:visibility="gone"
            app:blvShowTrack="false" />

        <TextView
            android:id="@+id/sll_refresh_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pull_to_refresh"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
