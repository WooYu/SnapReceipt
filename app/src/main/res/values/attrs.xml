<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="PrimaryActionButton">
        <attr name="android:text" />
        <attr name="pabCornerRadius" format="dimension" />
        <attr name="pabTextSize" format="dimension" />
        <attr name="pabTextColor" format="color" />
        <attr name="pabRippleColor" format="color" />
        <attr name="pabPressedDarkenFactor" format="float" />
        <attr name="pabBackgroundStyle">
            <enum name="gradient" value="0" />
            <enum name="solid" value="1" />
        </attr>
        <attr name="pabGradientStartColor" format="color" />
        <attr name="pabGradientEndColor" format="color" />
        <attr name="pabSolidColor" format="color" />
        <attr name="pabStrokeColor" format="color" />
        <attr name="pabStrokeWidth" format="dimension" />
        <attr name="pabEnableShadow" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SnapCardView">
        <attr name="scvShowShadow" format="boolean" />
    </declare-styleable>

    <declare-styleable name="MeMenuItemView">
        <attr name="mmivIcon" format="reference" />
        <attr name="mmivTitle" format="reference|string" />
        <attr name="mmivValueText" format="reference|string" />
        <attr name="mmivShowArrow" format="boolean" />
        <attr name="mmivShowBackground" format="boolean" />
        <attr name="mmivSwapTitleValueStyle" format="boolean" />
    </declare-styleable>

    <declare-styleable name="StatefulListLayout">
        <attr name="sllEmptyImage" format="reference" />
        <attr name="sllEmptyText" format="reference|string" />
        <attr name="sllNoMoreText" format="reference|string" />
    </declare-styleable>

    <declare-styleable name="LoadingOverlayView">
        <attr name="lovText" format="reference|string" />
        <attr name="lovOverlayColor" format="color" />
    </declare-styleable>

    <declare-styleable name="PageTitleBar">
        <attr name="ptbTitleText" format="reference|string" />
        <attr name="ptbTitleTextColor" format="color" />
        <attr name="ptbLeftIcon" format="reference" />
        <attr name="ptbRightIcon" format="reference" />
        <attr name="ptbShowLeftIcon" format="boolean" />
        <attr name="ptbShowRightIcon" format="boolean" />
        <attr name="ptbBackground" format="color|reference" />
    </declare-styleable>
</resources>
