<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 主色调：保持您的皇家蓝 -->
    <color name="colorPrimary">#103CED</color>

    <!-- 主色调变体：与主色一致，保持统一 -->
    <color name="colorPrimaryVariant">#103CED</color>

    <!-- 次要颜色/强调色：用于渐变与选中态 -->
    <color name="colorSecondary">#2F6BFF</color>

    <!-- 次要颜色变体：与次要色一致 -->
    <color name="colorSecondaryVariant">@color/colorSecondary</color>

    <!-- 主按钮渐变结束色 -->
    <color name="colorPrimaryGradientEnd">#02D7FD</color>

    <!-- 错误色：标准的 Material Red，保持即可 -->
    <color name="colorError">#B00020</color>

    <!-- 文本/内容颜色 -->
    <!-- 在主色(蓝)上的文字：白色 -->
    <color name="colorOnPrimary">#FFFFFF</color>

    <!-- 在次要色上的文字：使用深色文字以保证可读性 -->
    <color name="colorOnSecondary">#1E2430</color>

    <color name="colorOnError">#FFFFFF</color>

    <!-- 背景色 -->
    <!-- 页面大背景 -->
    <color name="colorBackground">#F3F6FD</color>

    <!-- 卡片/表面背景：纯白 -->
    <color name="colorSurface">#FFFFFF</color>

    <!-- 背景上的文字：使用深蓝灰，比纯黑更柔和 -->
    <color name="colorOnBackground">#1E2430</color>
    <color name="colorOnSurface">#1E2430</color>

    <color name="text_title">#22263F</color>
    <color name="text_primary">#323B4B</color>
    <color name="text_secondary">#7D899C</color>
    <color name="text_muted">#BDC4D0</color>
    <color name="text_muted_dark">#B2B9C5</color>

    <!-- 底部导航栏文字颜色 -->
    <color name="nav_text_selected">#103CED</color>
    <color name="nav_text_unselected">#A9B6E5</color>
    <!--分割线-->
    <color name="line_mine">#F7F7F7</color>
</resources>
